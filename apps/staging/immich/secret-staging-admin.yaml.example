# Template for secret-staging-admin.yaml — the staging Immich admin that
# cronjob-bootstrap.yaml creates and logs in as. Operator step (SOPS is
# operator-only):
#
#   cp secret-staging-admin.yaml.example secret-staging-admin.yaml
#   $EDITOR secret-staging-admin.yaml          # fill both values
#   sops -e -i secret-staging-admin.yaml
#
# email: use the address Authelia sends for you. Immich links an OAuth login
#   to an existing user with the same email, so "Login with Authelia" on
#   photos.stage.burntbytes.com then lands you in this admin account, which
#   owns the staging library.
# password: any strong value. Only the bootstrap Job uses it.
apiVersion: v1
kind: Secret
metadata:
  name: immich-staging-admin
  namespace: immich-stage
type: Opaque
stringData:
  email: CHANGE_ME
  password: CHANGE_ME
