# Template for secret-doc-store.yaml: MinIO's root credentials, which the api,
# workers, migrator and the bucket Job also use to reach the bucket (chart
# value external_secrets.doc_store_existingSecret). It replaces the Secret the
# chart would otherwise render with its public defaults (admin / password).
# Every key below is required; the chart reads them all from this one Secret.
# Operator step (SOPS is operator-only):
#
#   cp secret-doc-store.yaml.example secret-doc-store.yaml
#   $EDITOR secret-doc-store.yaml   # e.g. `openssl rand -hex 24` for the password
#   sops -e -i secret-doc-store.yaml
#   # then uncomment secret-doc-store.yaml in kustomization.yaml
#
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD and AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY must be the same pair. MinIO reads its root password
# only when its data volume is first initialised, so set it before the first
# install and don't change it afterwards without rotating it in MinIO too.
apiVersion: v1
kind: Secret
metadata:
  name: plane-doc-store
  namespace: plane-prod
type: Opaque
stringData:
  USE_MINIO: "1"
  FILE_SIZE_LIMIT: "5242880"
  AWS_S3_BUCKET_NAME: uploads
  AWS_S3_ENDPOINT_URL: http://plane-minio:9000
  MINIO_ROOT_USER: plane-admin
  MINIO_ROOT_PASSWORD: CHANGE_ME
  AWS_ACCESS_KEY_ID: plane-admin
  AWS_SECRET_ACCESS_KEY: CHANGE_ME
