# Template for secret-app-keys.yaml: Plane's signing keys, read by the api,
# workers, migrator and live (chart value external_secrets.app_keys_existingSecret).
# The chart refuses to render without it (env.requireExplicitSecrets). Operator
# step (SOPS is operator-only):
#
#   cp secret-app-keys.yaml.example secret-app-keys.yaml
#   $EDITOR secret-app-keys.yaml        # e.g. `openssl rand -hex 32` for each
#   sops -e -i secret-app-keys.yaml
#   # then uncomment secret-app-keys.yaml in kustomization.yaml
#
# SECRET_KEY also derives the key that encrypts instance settings (SMTP
# password, OAuth client secrets). Changing it later makes those
# undecryptable, silently. Set it once per environment and don't rotate it.
apiVersion: v1
kind: Secret
metadata:
  name: plane-app-keys
  namespace: plane-prod
type: Opaque
stringData:
  SECRET_KEY: CHANGE_ME
  LIVE_SERVER_SECRET_KEY: CHANGE_ME
