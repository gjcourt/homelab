# TEMPLATE — operator-only. Agents never run sops in this repo.
#
# The Plane API key that ticket Jobs use (agent-desk plan, step 5). agent-desk
# adds it to each ticket Job as PLANE_API_KEY (optional, so a Job still starts
# without it, just with no Plane access). The console never gets it.
#
# Which key:
#   - step 5 test, against staging Plane: collab-test's staging key (collab-test
#     stands in for agent-desk on staging; it's a member of SANDBOX and SMOKE only);
#   - from step 6: the agent-desk bot's SECOND production key, not the
#     dispatcher's, so each can be revoked alone (plan, "Plane identity").
#
#   cp apps/production/bench-cloud/secret-plane-jobs-token.yaml.example \
#      apps/production/bench-cloud/secret-plane-jobs-token.yaml
#   # paste the key below
#   sops -e -i apps/production/bench-cloud/secret-plane-jobs-token.yaml
#   # then uncomment its line in kustomization.yaml
#
# Revoke/rotate: Plane → Profile settings → API tokens, signed in as the bot.
# Never commit an unencrypted secret-plane-jobs-token.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: bench-cloud-plane-jobs-token
  namespace: bench-cloud
type: Opaque
stringData:
  PLANE_API_KEY: "REPLACE-ME"
