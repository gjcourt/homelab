# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/production/bench-cloud/secret-github-app.yaml.example \
#      apps/production/bench-cloud/secret-github-app.yaml
#   # fill in the four values below
#   sops -e -i apps/production/bench-cloud/secret-github-app.yaml
#
# From the `bench-cloud` GitHub App (Settings > Developer settings > GitHub Apps):
#   app-id           — "App ID" on the App's General page
#   private-key.pem  — "Generate a private key" (downloads a .pem); paste it whole
#   installation-id  — install the App on gjcourt (All repositories); the number
#                      at the end of the installation's settings URL
#   bot-email        — <bot-user-id>+bench-cloud[bot]@users.noreply.github.com, where
#                      bot-user-id = `gh api /users/bench-cloud%5Bbot%5D --jq .id`
#
# Never commit an unencrypted secret-github-app.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: bench-cloud-github-app
  namespace: bench-cloud
type: Opaque
stringData:
  app-id: "REPLACE-ME"
  installation-id: "REPLACE-ME"
  bot-email: "REPLACE-ME+bench-cloud[bot]@users.noreply.github.com"
  private-key.pem: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE-ME
    -----END RSA PRIVATE KEY-----
