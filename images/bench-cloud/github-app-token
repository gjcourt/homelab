#!/usr/bin/env bash
# Mint (and cache) a GitHub App installation token for bench-cloud.
#
#   github-app-token                    print a token (for gh, curl)
#   github-app-token --git-credential get   git credential-helper protocol
#
# Installation tokens live 1 h; the cache is refreshed with 10 min to spare, so
# a leaked token is dead within the hour. The private key never leaves the pod.
#
# Env: GITHUB_APP_ID (required), GITHUB_APP_PRIVATE_KEY_FILE
#      (default /var/run/secrets/github-app/private-key.pem),
#      GITHUB_APP_INSTALLATION_ID (optional; looked up if unset).
set -euo pipefail
umask 077  # the cache holds a live token

if [[ "${1:-}" == "--git-credential" ]]; then
  # git calls helpers with get/store/erase; only "get" needs an answer.
  [[ "${2:-}" == "get" ]] || exit 0
  cat >/dev/null  # drain the request git writes to stdin
  # Mint first: a failure inside printf's "$(...)" would slip past `set -e` and
  # hand git an empty password instead of failing loudly.
  token="$("$0")" || exit 1
  printf 'username=x-access-token\npassword=%s\n' "$token"
  exit 0
fi

: "${GITHUB_APP_ID:?GITHUB_APP_ID not set}"
KEY="${GITHUB_APP_PRIVATE_KEY_FILE:-/var/run/secrets/github-app/private-key.pem}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/github-app-token.json"
API=https://api.github.com
now=$(date +%s)

if [[ -r "$CACHE" ]]; then
  exp=$(jq -r '.expires_at // empty' "$CACHE" | xargs -r -I{} date -d {} +%s || true)
  if [[ -n "${exp:-}" ]] && (( exp - now > 600 )); then
    # A cache without a token falls through to a fresh mint.
    tok=$(jq -er .token "$CACHE") && { printf '%s\n' "$tok"; exit 0; }
  fi
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$GITHUB_APP_ID" | b64url)
sig=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)
jwt="$header.$payload.$sig"

gh_api() { curl -fsS -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" "$@"; }

inst="${GITHUB_APP_INSTALLATION_ID:-}"
if [[ -z "$inst" ]]; then
  inst=$(gh_api "$API/app/installations" | jq -r 'if length == 1 then .[0].id else error("expected exactly one installation, found \(length); set GITHUB_APP_INSTALLATION_ID") end')
fi

mkdir -p "$(dirname "$CACHE")"
# Per-process temp file: git and gh mint concurrently, and a shared name races.
tmp=$(mktemp "$CACHE.XXXXXX")
trap 'rm -f "$tmp"' EXIT
gh_api -X POST "$API/app/installations/$inst/access_tokens" > "$tmp"
tok=$(jq -er .token "$tmp")  # fails (and caches nothing) on a tokenless reply
mv "$tmp" "$CACHE"
printf '%s\n' "$tok"
