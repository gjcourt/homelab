# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/staging/plane-mobile/secret-plane-mobile.yaml.example \
#      apps/staging/plane-mobile/secret-plane-mobile.yaml
#   # fill in the values below
#   sops -e -i apps/staging/plane-mobile/secret-plane-mobile.yaml
#
# Every value is staging's own; none is shared with production.
#
#   oidc-client-secret — plaintext half of the plane-mobile client on staging
#                        Authelia. Generate both halves with
#                          authelia crypto hash generate pbkdf2 --variant sha512 \
#                            --random --random.length 72 --random.charset rfc3986
#                        The digest replaces the placeholder client_secret in
#                        apps/staging/authelia/configuration.yaml.
#   session-key        — signs the session cookie; at least 32 characters:
#                          openssl rand -hex 32
#   vapid-private-key  — PEM, P-256:
#                          openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#                        Its public half (uncompressed point, base64url) goes in
#                        VAPID_PUBLIC_KEY in kustomization.yaml:
#                          openssl ec -in vapid.pem -pubout -outform DER 2>/dev/null \
#                            | tail -c 65 | base64 | tr '/+' '_-' | tr -d '=\n'
#   plane-api-key      — a staging Plane API token of George's own user (the
#                        OWNER_EMAIL account), created only for this service
#                        (Profile settings > API tokens). Not collab-test's, as
#                        agent-desk-stage uses: Plane attributes every comment
#                        the app posts to the token's owner, so a bot token
#                        would make answers from the phone count as the bot's
#                        (plane-mobile plan, "Whose token it is").
#                        Only read with PLANE_READ=on.
#   webhook-secret     — the secret staging Plane shows when the webhook is created:
#                        plane.stage.burntbytes.com > Workspace settings > Webhooks >
#                        Add webhook, URL
#                        http://plane-mobile.plane-mobile-stage.svc.cluster.local/plane,
#                        events: Work items and Work item comments.
#                        Only read with PLANE_READ=on.
#
# Never commit an unencrypted secret-plane-mobile.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: plane-mobile
  namespace: plane-mobile-stage
type: Opaque
stringData:
  oidc-client-secret: "REPLACE-ME"
  session-key: "REPLACE-ME"
  vapid-private-key: |
    -----BEGIN EC PRIVATE KEY-----
    REPLACE-ME
    -----END EC PRIVATE KEY-----
  plane-api-key: "REPLACE-ME"
  webhook-secret: "REPLACE-ME"
