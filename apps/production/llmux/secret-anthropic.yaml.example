# TEMPLATE — operator-only. Agents never run sops in this repo.
#
# To create the real file:
#
#   cp apps/production/llmux/secret-anthropic.yaml.example \
#      apps/production/llmux/secret-anthropic.yaml
#   # paste the Anthropic API key into LLMUX_ANTHROPIC_API_KEY below
#   sops -e -i apps/production/llmux/secret-anthropic.yaml
#
# The production kustomization already lists secret-anthropic.yaml, so
# `kustomize build apps/production` (and CI) fails until the encrypted file
# exists. That failure is the intended gate.
#
# Never commit an unencrypted secret-anthropic.yaml.
#
# This replaces OPENAI_API_KEY in openwebui-anthropic once Open WebUI is cut
# over to llmux (a separate PR).
apiVersion: v1
kind: Secret
metadata:
  name: llmux-anthropic
  namespace: llmux
  labels:
    app: llmux
type: Opaque
stringData:
  LLMUX_ANTHROPIC_API_KEY: "sk-ant-REPLACE-ME"
