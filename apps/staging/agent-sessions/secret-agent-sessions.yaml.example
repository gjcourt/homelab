# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/staging/agent-sessions/secret-agent-sessions.yaml.example \
#      apps/staging/agent-sessions/secret-agent-sessions.yaml
#   # fill in session-key below: openssl rand -hex 32
#   sops -e -i apps/staging/agent-sessions/secret-agent-sessions.yaml
#   # then uncomment `- secret-agent-sessions.yaml` in kustomization.yaml
#
#   session-key — the HMAC key for the per-Job tokens, at least 32 bytes (the
#                 service refuses to start with less). Staging's own: never
#                 the production key. agent-desk-stage's Secret gets the same
#                 value when agent-desk starts minting tokens (a later PR).
#
# Never commit an unencrypted secret-agent-sessions.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: agent-sessions
  namespace: agent-sessions-stage
type: Opaque
stringData:
  session-key: "REPLACE-ME"
