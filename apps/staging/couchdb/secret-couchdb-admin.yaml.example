# CouchDB server-admin credentials. George creates the real file, then
# encrypts it and lists it in kustomization.yaml:
#   cp secret-couchdb-admin.yaml.example secret-couchdb-admin.yaml
#   # set username and a long random password
#   sops -e -i secret-couchdb-admin.yaml
# The entrypoint writes these into local.d/docker.ini on every start, so a
# password change here takes effect on the next pod restart.
apiVersion: v1
kind: Secret
metadata:
  name: couchdb-admin
  namespace: couchdb-stage
type: Opaque
stringData:
  username: admin
  password: CHANGE_ME
