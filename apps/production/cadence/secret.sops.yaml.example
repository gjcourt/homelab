# Template for the cadence-secrets Secret. The OPERATOR creates the real, SOPS-encrypted
# file (secret.sops.yaml), then adds `- secret.sops.yaml` to kustomization.yaml.
# NEVER commit plaintext secret values — encrypt with `sops -e -i` first (key ref: .sops.yaml).
#
#   1. cp secret.sops.yaml.example secret.sops.yaml
#   2. fill in the real values below
#   3. sops -e -i secret.sops.yaml
#   4. add `- secret.sops.yaml` to kustomization.yaml
#
# Values:
#   SHOPIFY_API_KEY / SHOPIFY_API_SECRET  — Shopify Partner/Dev Dashboard (the app's client id/secret)
#   STRIPE_SECRET_KEY                     — Stripe card rail (test mode: sk_test_...)
#   CADENCE_ACCEPTANCE_PRIV_PEM / _PUB_HEX — STABLE receipt-signing keypair (`npm run keygen`);
#                                           without it the app uses an ephemeral key and receipts
#                                           won't verify across restarts.
apiVersion: v1
kind: Secret
metadata:
  name: cadence-secrets
  namespace: cadence
type: Opaque
stringData:
  SHOPIFY_API_KEY: "REPLACE_ME"
  SHOPIFY_API_SECRET: "REPLACE_ME"
  STRIPE_SECRET_KEY: "sk_test_REPLACE_ME"
  CADENCE_ACCEPTANCE_PRIV_PEM: "REPLACE_ME"
  CADENCE_ACCEPTANCE_PUB_HEX: "REPLACE_ME"
