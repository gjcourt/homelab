# CouchDB server-admin credentials and the session-cookie secret. Wired into
# kustomization.yaml already; kustomize build / CI fails until the encrypted
# file exists — that is the intended gate. George creates and encrypts it:
#   cp secret-couchdb-admin.yaml.example secret-couchdb-admin.yaml
#   # set a long random password and cookie-secret (e.g. openssl rand -hex 32)
#   sops -e -i secret-couchdb-admin.yaml
# The entrypoint writes these into local.d/docker.ini on every start, so a
# change here takes effect on the next pod restart.
apiVersion: v1
kind: Secret
metadata:
  name: couchdb-admin
  namespace: couchdb-stage
type: Opaque
stringData:
  username: admin
  password: CHANGE_ME
  cookie-secret: CHANGE_ME
