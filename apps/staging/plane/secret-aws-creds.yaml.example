# Template for secret-aws-creds.yaml: S3 credentials for the CNPG WAL archive
# and base backups (objectstore.yaml). Same keys as the other staging
# clusters' backup secrets. Operator step (SOPS is operator-only):
#
#   cp secret-aws-creds.yaml.example secret-aws-creds.yaml
#   $EDITOR secret-aws-creds.yaml
#   sops -e -i secret-aws-creds.yaml
#   # then add secret-aws-creds.yaml to kustomization.yaml's resources
apiVersion: v1
kind: Secret
metadata:
  name: plane-aws-creds-secret
  namespace: plane-stage
type: Opaque
stringData:
  ACCESS_KEY_ID: CHANGE_ME
  ACCESS_SECRET_KEY: CHANGE_ME
