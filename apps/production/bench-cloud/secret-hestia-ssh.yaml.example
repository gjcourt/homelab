# TEMPLATE — operator-only. Agents never run sops in this repo.
#
# Two keys, made only for this (rrsync confines each key to one directory):
#
#   ssh-keygen -t ed25519 -N '' -C bench-cloud-inbox -f /tmp/bench-inbox
#   ssh-keygen -t ed25519 -N '' -C bench-cloud-media -f /tmp/bench-media
#   ssh-keyscan -t ed25519 10.42.2.10 | sed 's/^10.42.2.10/hestia/' > /tmp/bench-known_hosts
#   cp apps/production/bench-cloud/secret-hestia-ssh.yaml.example \
#      apps/production/bench-cloud/secret-hestia-ssh.yaml
#   # paste the two private keys and the known_hosts line below
#   sops -e -i apps/production/bench-cloud/secret-hestia-ssh.yaml
#   rm /tmp/bench-inbox /tmp/bench-media /tmp/bench-known_hosts   # keep the .pub files for hestia
#
# The .pub files go into bench-agent's authorized_keys on hestia, each behind a
# forced rrsync command (docs/operations/apps/bench-cloud.md). known_hosts is
# keyed on `hestia` because the pod's ssh config sets HostKeyAlias hestia.
#
# Never commit an unencrypted secret-hestia-ssh.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: bench-cloud-hestia-ssh
  namespace: bench-cloud
type: Opaque
stringData:
  id_inbox: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    REPLACE-ME
    -----END OPENSSH PRIVATE KEY-----
  id_media: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    REPLACE-ME
    -----END OPENSSH PRIVATE KEY-----
  known_hosts: |
    hestia ssh-ed25519 REPLACE-ME
