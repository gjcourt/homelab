# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/staging/homeassistant/secret-homeassistant-secrets.yaml.example \
#      apps/staging/homeassistant/secret-homeassistant-secrets.yaml
#   # replace REPLACE-ME with a fresh random id:  openssl rand -hex 24
#   sops -e -i apps/staging/homeassistant/secret-homeassistant-secrets.yaml
#
# Mounted as Home Assistant's /config/secrets.yaml, for the !secret references
# in files/automations.yaml. It must exist before the deployment that mounts it:
# without it Home Assistant can't load automations.yaml.
#
#   agent_desk_webhook_id — the id of the "agent-desk — notify George" webhook.
#                           The same value goes in agent-desk's secret as
#                           notify-webhook-id (apps/staging/agent-desk).
#                           Use a different id per environment.
#
# Never commit an unencrypted secret-homeassistant-secrets.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: homeassistant-secrets
  namespace: homeassistant-stage
type: Opaque
stringData:
  secrets.yaml: |
    agent_desk_webhook_id: REPLACE-ME
