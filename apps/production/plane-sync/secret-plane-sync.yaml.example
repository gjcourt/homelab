# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/production/plane-sync/secret-plane-sync.yaml.example \
#      apps/production/plane-sync/secret-plane-sync.yaml
#   # fill in the two values below
#   sops -e -i apps/production/plane-sync/secret-plane-sync.yaml
#   # then uncomment `- secret-plane-sync.yaml` in kustomization.yaml
#
#   plane-api-key — logged in to plane.burntbytes.com as the plane-sync bot
#                   (gjcourt+plane-sync@gmail.com): Profile settings > API tokens.
#   github-token  — a fine-grained PAT (github.com > Settings > Developer
#                   settings > Fine-grained tokens), resource owner gjcourt:
#                     gjcourt/lab:        Contents read/write, Pull requests read/write
#                     gjcourt/homelab:    Contents read, Pull requests read
#                     gjcourt/domestique: Contents read, Pull requests read
#                   (Metadata read is added automatically.)
#
# Never commit an unencrypted secret-plane-sync.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: plane-sync
  namespace: plane-sync
type: Opaque
stringData:
  plane-api-key: "REPLACE-ME"
  github-token: "REPLACE-ME"
