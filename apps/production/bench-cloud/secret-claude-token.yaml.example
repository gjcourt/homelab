# TEMPLATE — operator-only. Agents never run sops in this repo.
#
# The inference-only subscription token for task Jobs (phase 2,
# scripts/bench-cloud/). The CONSOLE must never get this: it takes precedence
# over the console's full `claude auth login` and Remote Control refuses it.
#
#   claude setup-token        # on the Mac; prints a long-lived token
#   cp apps/production/bench-cloud/secret-claude-token.yaml.example \
#      apps/production/bench-cloud/secret-claude-token.yaml
#   # paste the token below (or from ~/.config/anthropic/oauth_token)
#   sops -e -i apps/production/bench-cloud/secret-claude-token.yaml
#
# Revoke/rotate: claude.ai → Settings → Claude Code → long-lived tokens.
# Never commit an unencrypted secret-claude-token.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: bench-cloud-claude-token
  namespace: bench-cloud
type: Opaque
stringData:
  CLAUDE_CODE_OAUTH_TOKEN: "REPLACE-ME"
