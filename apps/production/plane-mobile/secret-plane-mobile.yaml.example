# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/production/plane-mobile/secret-plane-mobile.yaml.example \
#      apps/production/plane-mobile/secret-plane-mobile.yaml
#   # fill in the values below
#   sops -e -i apps/production/plane-mobile/secret-plane-mobile.yaml
#
# Every value is production's own; none is shared with staging. The full
# operator sequence (and why the webhook secret comes second) is in
# docs/operations/apps/plane-mobile.md, "Production: operator steps".
#
#   oidc-client-secret — plaintext half of the plane-mobile client on
#                        production Authelia. Generate both halves with
#                          authelia crypto hash generate pbkdf2 --variant sha512 \
#                            --random --random.length 72 --random.charset rfc3986
#                        The digest replaces the placeholder client_secret in
#                        apps/production/authelia/configuration.yaml.
#   session-key        — signs the session cookie; at least 32 characters:
#                          openssl rand -hex 32
#   vapid-private-key  — PEM, P-256:
#                          openssl ecparam -name prime256v1 -genkey -noout -out vapid-prod.pem
#                        Its public half (uncompressed point, base64url) goes in
#                        VAPID_PUBLIC_KEY in kustomization.yaml:
#                          openssl ec -in vapid-prod.pem -pubout -outform DER 2>/dev/null \
#                            | tail -c 65 | base64 | tr '/+' '_-' | tr -d '=\n'
#   plane-api-key      — a production Plane API token of George's own user
#                        (gjcourt@gmail.com, the OWNER_EMAIL account), created
#                        only for this service (plane.burntbytes.com > Profile
#                        settings > API tokens). Not the agent-desk bot's:
#                        Plane attributes every comment the app posts to the
#                        token's owner.
#   webhook-secret     — the secret production Plane shows when the webhook is
#                        created: plane.burntbytes.com > Workspace settings >
#                        Webhooks > Add webhook, URL
#                        http://plane-mobile.plane-mobile-prod.svc.cluster.local/plane,
#                        events: Work items and Work item comments. The webhook
#                        can only be saved once this PR is merged (Plane checks
#                        WEBHOOK_ALLOWED_HOSTS on save), so the first commit
#                        uses a random placeholder (openssl rand -hex 32).
#
# Never commit an unencrypted secret-plane-mobile.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: plane-mobile
  namespace: plane-mobile-prod
type: Opaque
stringData:
  oidc-client-secret: "REPLACE-ME"
  session-key: "REPLACE-ME"
  vapid-private-key: |
    -----BEGIN EC PRIVATE KEY-----
    REPLACE-ME
    -----END EC PRIVATE KEY-----
  plane-api-key: "REPLACE-ME"
  webhook-secret: "REPLACE-ME"
