# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/production/agent-desk/secret-agent-desk.yaml.example \
#      apps/production/agent-desk/secret-agent-desk.yaml
#   # fill in the values below
#   sops -e -i apps/production/agent-desk/secret-agent-desk.yaml
#
#   plane-api-key  — production Plane, the dispatcher's key: signed in as the
#                    agent-desk bot, Profile settings → API tokens. The bot's
#                    SECOND key goes to bench-cloud's Jobs instead
#                    (apps/production/bench-cloud/secret-plane-jobs-token.yaml),
#                    so each can be revoked alone (plan, "Plane identity").
#   webhook-secret — the secret Plane shows when the webhook is created:
#                    plane.burntbytes.com > Workspace settings > Webhooks >
#                    Add webhook, URL
#                    http://agent-desk.agent-desk.svc.cluster.local/plane,
#                    events: Work items and Work item comments.
#   github-token   — fine-grained PAT, read-only: Pull requests read and
#                    Actions read (plan, "GitHub identity"), on every repo
#                    mapped in config.yaml: gjcourt/agent-sandbox,
#                    gjcourt/plane-mobile, gjcourt/domestique. Mapping a new repo
#                    means adding it to this token too. It moves In review → Done
#                    when the PR merges, and wakes a Job on George's review.
#   notify-webhook-id — the agent_desk_webhook_id already in
#                    apps/production/homeassistant/secret-homeassistant-secrets.yaml.
#
# Never commit an unencrypted secret-agent-desk.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: agent-desk
  namespace: agent-desk
type: Opaque
stringData:
  plane-api-key: "REPLACE-ME"
  webhook-secret: "REPLACE-ME"
  github-token: "REPLACE-ME"
  notify-webhook-id: "REPLACE-ME"
