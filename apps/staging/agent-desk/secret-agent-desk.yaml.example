# TEMPLATE — operator-only. Agents never run sops in this repo.
#
#   cp apps/staging/agent-desk/secret-agent-desk.yaml.example \
#      apps/staging/agent-desk/secret-agent-desk.yaml
#   # fill in the values below
#   sops -e -i apps/staging/agent-desk/secret-agent-desk.yaml
#   # then uncomment `- secret-agent-desk.yaml` in kustomization.yaml
#
#   plane-api-key  — staging Plane, the dispatcher's identity. On staging that's
#                    the collab-test Member (no agent-desk account there).
#   webhook-secret — the secret Plane shows when the webhook is created:
#                    plane.stage.burntbytes.com > Workspace settings > Webhooks >
#                    Add webhook, URL
#                    http://agent-desk.agent-desk-stage.svc.cluster.local/plane,
#                    events: Work items and Work item comments.
#   github-token   — optional until step 6 (leave the line out on staging).
#   notify-webhook-id — optional: the agent_desk_webhook_id from
#                    apps/staging/homeassistant/secret-homeassistant-secrets.yaml.
#                    Without it agent-desk sends no notifications.
#
# Never commit an unencrypted secret-agent-desk.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: agent-desk
  namespace: agent-desk-stage
type: Opaque
stringData:
  plane-api-key: "REPLACE-ME"
  webhook-secret: "REPLACE-ME"
  notify-webhook-id: "REPLACE-ME"
